# Flask Security Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key for Session Encryption and CSRF Tokens
# Generate in python with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Password Hashing Configuration
# Configurable work factor (iterations) for PBKDF2-HMAC-SHA-256
# Recommended minimum by NIST is 100,000 to 600,000
PBKDF2_ITERATIONS=100000

# Server Port (default: 5050)
PORT=5050
